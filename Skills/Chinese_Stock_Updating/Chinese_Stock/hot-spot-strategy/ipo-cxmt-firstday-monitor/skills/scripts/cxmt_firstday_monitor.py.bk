# ==================== 常量配置 ====================

# 长鑫科技发行价区间(元)
CXMT_ISSUE_PRICE_MIN = 7.0
CXMT_ISSUE_PRICE_MAX = 10.0
CXMT_PRICE_THRESHOLD_80 = 12.6   # 涨幅80%的价格线(按发行价10元计)
CXMT_PRICE_THRESHOLD_50 = 10.5   # 涨幅50%的价格线

# 科创板新股首日规则
# 集合竞价：9:15-9:25 (9:20-9:25不可撤单)
# 连续竞价：9:30起 ±2%价格笼子
# 尾盘撮合：14:50-15:00

# 四个阶段时间窗口
PHASE_AUCTION_START   = dtime(9, 15)
PHASE_AUCTION_END     = dtime(9, 25)
PHASE_OPEN            = dtime(9, 30)
PHASE_PULLBACK_START  = dtime(9, 32)
PHASE_PULLBACK_END    = dtime(10, 0)
PHASE_TAIL_START      = dtime(14, 50)
PHASE_TAIL_END        = dtime(15, 0)

# 首日仓位上限
MAX_FIRSTDAY_POSITION = 400000   # 40万
WATCH_POSITION_LIMIT  = 200000   # 20万(弱势情景)

# 仓位规则(分阶段)
POSITION_RULES = {
