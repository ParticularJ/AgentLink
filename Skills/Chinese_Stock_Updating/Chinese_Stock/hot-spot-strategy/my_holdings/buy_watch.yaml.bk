# 早盘情绪监控 · 买入观察名单
# 格式说明:
#   trigger_mode: pct_vs_close(跌破昨收X%) | range_price(区间) | auction_strong(竞价强势追)
#   phase: all | open | auction
#   金额: 单次买入上限

watchlist:

  # ═══════════════════════════════════════════
  # 保守策略：等恐慌回调买
  # ═══════════════════════════════════════════

  # ── 海兰信(300065) ── 军工题材，强势
  # 现价28.79，昨收23.99，今日+20%（已是高位）
  # 策略: 回调-3%买，深度恐慌-8%轻仓
  - code: "300065"
    name: "海兰信"
    trigger_mode: "pct_vs_close"
    trigger_value: -3.0
    phase: "all"
    max_position: 30000
    reason: "回调-3%买，等恐慌不追高"

  - code: "300065"
    name: "海兰信"
    trigger_mode: "pct_vs_close"
    trigger_value: -8.0
    phase: "all"
    max_position: 20000
    reason: "深度恐慌，航空航天主线轻仓试探"

  # ── 九丰能源(605090) ── 能源题材
  # 现价37.98，昨收34.53，今日+10%
  # 策略: 回调-3%买，或回踩昨收34.5附近
  - code: "605090"
    name: "九丰能源"
    trigger_mode: "pct_vs_close"
    trigger_value: -3.0
    phase: "all"
    max_position: 30000
    reason: "回调-3%买"

  - code: "605090"
    name: "九丰能源"
    trigger_mode: "range_price"
    trigger_value: "34.0,35.5"
    phase: "all"
    max_position: 30000
    reason: "回踩34-35.5区间买"

