    phase: "all"
    max_position: 30000
    reason: "回踩15.5-16.5区间买"

  # ── 斯瑞新材(688102) ── 新材料题材
  # 现价46.09，昨收41.39，今日+11.4%
  # 策略: 回调-3%买，或到42-44区间
  - code: "688102"
    name: "斯瑞新材"
    trigger_mode: "pct_vs_close"
